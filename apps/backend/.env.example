PORT=3001
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=local

# Jev stays unavailable until key, explicit budget and persistent usage path are set.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_MAX_REQUESTS=0
TYPESAFE_MAX_REQUESTS_PER_MATCH=10
TYPESAFE_DECISION_TIMEOUT_MS=15000
TYPESAFE_USAGE_FILE=.cache/typesafe-usage.json
